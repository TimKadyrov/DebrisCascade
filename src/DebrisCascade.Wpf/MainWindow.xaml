<Window x:Class="DebrisCascade.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DebrisCascade — LEO Debris Model" Height="760" Width="1180"
        Background="#0B0F17" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E7EEF8"/>
        <SolidColorBrush x:Key="Dim" Color="#9FB2CC"/>
        <SolidColorBrush x:Key="Panel" Color="#111A28"/>
        <SolidColorBrush x:Key="Line" Color="#2A3A52"/>
        <SolidColorBrush x:Key="Cyan" Color="#4DA6FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,6,0,1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A1019"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="5,3"/><Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E2C42"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="Cursor" Value="Hand"/>
            <!-- Own template: the default one swaps in a light background on hover and when disabled,
                 which leaves light label text unreadable. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4163"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4DA6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#15314A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Two-line button labels: the view, then (dimmer) the engine it always uses and why -->
        <Style x:Key="BtnTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="BtnSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#B4C6DD"/><Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Inputs -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="14,4,14,14" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="INPUTS" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Cyan}"
                               Margin="0,10,0,2" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Head}" Text="ENGINE"/>
                    <RadioButton x:Name="EngineCube" GroupName="Engine" IsChecked="True" Content="Cube (GPU, every object on its orbit)"
                                 ToolTip="Tipping, Operators quit, Working satellites and Removal run the cube engine as a seed ensemble: mean, with the seed range shaded. The box model is drawn dashed as a cross-check."/>
                    <RadioButton x:Name="EngineBox" GroupName="Engine" Content="Box model (deterministic, fast)"
                                 ToolTip="Scenario views run the box model only. Scale check, Comparison and Usability always use the box model: it resolves effects smaller than the cube's seed scatter."/>
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=EngineCube}">
                        <TextBlock Style="{StaticResource Lbl}" Text="Seeds per cube ensemble"/>
                        <TextBox x:Name="Seeds" Text="8"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Head}" Text="BARREL"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Release altitude (km)"/>
                    <TextBox x:Name="AltKm" Text="900"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Inclination (deg)"/>
                    <TextBox x:Name="IncDeg" Text="53"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Nail count"/>
                    <TextBox x:Name="NailCount" Text="200000"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Nail length (mm)"/>
                            <TextBox x:Name="NailLen" Text="75"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Nail dia (mm)"/>
                            <TextBox x:Name="NailDia" Text="3"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Lbl}" Text="Dispersal σ (m/s per axis)"/>
                    <TextBox x:Name="SigmaMS" Text="50"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Relative velocity (m/s)"/>
                    <TextBox x:Name="RelVelMS" Text="10000"/>

                    <TextBlock Style="{StaticResource Head}" Text="ENVIRONMENT"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Objects added a year (satellites + rocket bodies)"/>
                    <TextBox x:Name="LaunchRate" Text="0"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Altitude they are added at (km)"/>
                    <TextBox x:Name="LaunchAlt" Text="900"/>
                    <CheckBox x:Name="Responsive" Content="Responsive launch (operators quit)"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Loss tolerance (fraction/yr)"/>
                    <TextBox x:Name="LossTol" Text="0.02"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Explosions (per yr, 0 = none)"/>
                    <TextBox x:Name="Explosions" Text="4"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Debris removal (objects/yr, riskiest first)"/>
                    <TextBox x:Name="Removals" Text="0"/>
                    <CheckBox x:Name="Working" Content="Working satellites (deorbit + dodge)" Margin="0,8,0,0"
                              ToolTip="Off: every satellite is dead from day one. On: active and launched satellites hold orbit, dodge tracked objects and are deorbited at end of life (box and cube engines)."/>
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=Working}">
                        <TextBlock Style="{StaticResource Lbl}" Text="Satellites deorbited at end of life (%)"/>
                        <TextBox x:Name="DisposalPct" Text="90"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Rocket bodies disposed of (%)"/>
                        <TextBox x:Name="RocketBodyPct" Text="80"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Conjunctions avoided (%, tracked objects)"/>
                        <TextBox x:Name="AvoidancePct" Text="90"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Satellite lifetime (years)"/>
                        <TextBox x:Name="LifetimeYr" Text="5"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Lbl}" Text="Solar activity (0.5 min .. 4 max)"/>
                    <TextBox x:Name="Solar" Text="1.0"/>
                    <TextBlock Style="{StaticResource Lbl}" Text="Horizon (years)"/>
                    <TextBox x:Name="Horizon" Text="50"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="DebrisCascade · Barrel-of-Nails LEO Debris Model"
                       FontSize="18" FontWeight="SemiBold" Margin="0,2,0,10"/>
            <StackPanel x:Name="Buttons" DockPanel.Dock="Top" Margin="0,0,0,10">
                <!-- Views that run on the engine picked on the left -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="118" Margin="0,4,6,0">
                        <TextBlock Text="SELECTED ENGINE" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                        <TextBlock x:Name="EngineCaption" Text="cube, 8 seeds" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button x:Name="BtnEvolve" Click="RunEvolve" Margin="0,0,6,6"
                                ToolTip="Belt debris ≥10 cm over time, with and without the barrel"><StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Evolution"/><TextBlock Style="{StaticResource BtnSub}" Text="belt over time"/></StackPanel></Button>
                        <Button x:Name="BtnTip" Click="RunTipping" Margin="0,0,6,6"
                                ToolTip="Belt growth vs objects added a year at the launch altitude"><StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Tipping sweep"/><TextBlock Style="{StaticResource BtnSub}" Text="growth vs traffic"/></StackPanel></Button>
                        <Button x:Name="BtnOps" Click="RunOperators" Margin="0,0,6,6"
                                ToolTip="Launching throughout vs operators throttling back and quitting"><StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Operators quit"/><TextBlock Style="{StaticResource BtnSub}" Text="keep launching vs quit"/></StackPanel></Button>
                        <Button x:Name="BtnWorking" Click="RunWorking" Margin="0,0,6,6"
                                ToolTip="Disposal and avoidance settings: never deorbited, poor, today's practice, best, yours"><StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Working satellites"/><TextBlock Style="{StaticResource BtnSub}" Text="disposal + avoidance"/></StackPanel></Button>
                        <Button x:Name="BtnRemoval" Click="RunRemoval" Margin="0,0,6,6"
                                ToolTip="Belt growth vs large dead objects removed a year"><StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Removal"/><TextBlock Style="{StaticResource BtnSub}" Text="removals a year"/></StackPanel></Button>
                    </WrapPanel>
                </DockPanel>
                <!-- Views tied to one engine by what they need; the small line says which and why -->
                <DockPanel Margin="0,4,0,0">
                    <StackPanel DockPanel.Dock="Left" Width="118" Margin="0,4,6,0">
                        <TextBlock Text="FIXED ENGINE" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                        <TextBlock Text="regardless of selection" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button x:Name="BtnGlobe" Click="RunGlobe" Margin="0,0,6,6"
                                ToolTip="Every object of one cube run around the Earth, every 5 years: drag to turn, slide through the years. Cube engine: only it has each object's position.">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Globe"/><TextBlock Style="{StaticResource BtnSub}" Text="cube · positions"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnUse" Click="RunUsability" Margin="0,0,6,6"
                                ToolTip="Collision risk per satellite by altitude, and how long debris stays. Box model: smooth per-shell rates.">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Usability by altitude"/><TextBlock Style="{StaticResource BtnSub}" Text="box · per-shell rates"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnBarrels" Click="RunBarrels" Margin="0,0,6,6"
                                ToolTip="How many barrels to move the belt, vs one ASAT strike. Box model: a barrel's effect is far below the cube's seed-to-seed scatter.">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Scale check (barrels)"/><TextBlock Style="{StaticResource BtnSub}" Text="box · resolves small effects"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnCompare" Click="RunComparison" Margin="0,0,6,6"
                                ToolTip="Barrel vs ASAT vs traffic on one measure. Box model: a barrel's effect is far below the cube's seed-to-seed scatter.">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Comparison"/><TextBlock Style="{StaticResource BtnSub}" Text="box · resolves small effects"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnNasa" Click="RunNasa" Margin="0,0,6,6"
                                ToolTip="The model against NASA's LEGEND and the IADC study: collision rates, growth without launches, removals to stabilise. The cube's 2006 benchmark is in data/benchmark_2006.json.">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="NASA comparison"/><TextBlock Style="{StaticResource BtnSub}" Text="box · collision rates"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnEngines" Click="RunEngines" Margin="0,0,6,6"
                                ToolTip="Box, discrete and cube engines on the same inputs, no barrel: how far they agree">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Engines side by side"/><TextBlock Style="{StaticResource BtnSub}" Text="box · discrete · cube"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnFlux" Click="RunFlux" Margin="0,0,6,6"
                                ToolTip="Single-nail lethality, drag lifetime and flux (text)">
                            <StackPanel><TextBlock Style="{StaticResource BtnTitle}" Text="Lethality &amp; Flux"/><TextBlock Style="{StaticResource BtnSub}" Text="nail physics"/></StackPanel>
                        </Button>
                        <Button x:Name="BtnSave" Content="Save PNG" Click="SavePng" Margin="12,0,6,6" Background="#15314A"
                                ToolTip="Save the current chart (and its text) as a PNG"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8" Height="220" Margin="0,10,0,0">
                <TextBox x:Name="ResultsBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Ink}"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" Padding="10"/>
            </Border>
            <Border x:Name="ChartPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Canvas x:Name="ChartCanvas" ClipToBounds="True"/>
                    <TextBlock x:Name="ChartHint" Text="Load complete — pick an analysis above."
                               Foreground="{StaticResource Dim}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Image x:Name="GlobeImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Visibility="Collapsed" Cursor="SizeAll"
                           MouseLeftButtonDown="Globe_MouseDown" MouseMove="Globe_MouseMove" MouseLeftButtonUp="Globe_MouseUp"/>
                    <StackPanel x:Name="GlobeOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,10,0,0"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="GlobeTitle" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GlobeStats" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="#7FA8D0" Margin="0,0,7,0"/><TextBlock FontSize="11" Text="intact: dead satellites, rocket bodies"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="#40F28C" Margin="0,0,7,0"/><TextBlock FontSize="11" Text="working satellites"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Rectangle Width="8" Height="8" Margin="0,0,7,0"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <TextBlock FontSize="11" Text="debris ≥10 cm, by altitude: red 700 km → yellow 1,100 km"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="#D973FF" Margin="0,0,7,0"/><TextBlock FontSize="11" Text="nails"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="#738CB3" Margin="0,0,7,0"/><TextBlock FontSize="11" Text="debris 1–10 cm (when shown)"/></StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="GlobeControls" Orientation="Horizontal" VerticalAlignment="Bottom"
                                HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="Year" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Dim}"/>
                        <Slider x:Name="GlobeSlider" Width="320" Minimum="0" Maximum="10" Value="0"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="GlobeSlider_ValueChanged"/>
                        <TextBlock x:Name="GlobeYear" Text="0" VerticalAlignment="Center" Margin="8,0,16,0"
                                   Foreground="{StaticResource Ink}" FontFamily="Consolas" Width="30"/>
                        <CheckBox x:Name="GlobeSmall" Content="show 1–10 cm debris" VerticalAlignment="Center" Margin="0"
                                  Checked="GlobeOption_Changed" Unchecked="GlobeOption_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="UsabilityControls" Orientation="Horizontal" VerticalAlignment="Bottom"
                                HorizontalAlignment="Center" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="Year" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Dim}"/>
                        <Slider x:Name="YearSlider" Width="360" Minimum="0" Maximum="50" Value="50"
                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                ValueChanged="YearSlider_ValueChanged"/>
                        <TextBlock x:Name="YearLabel" Text="50" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{StaticResource Ink}" FontFamily="Consolas" Width="30"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Status bar -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" Height="0"/>
    </Grid>
</Window>
