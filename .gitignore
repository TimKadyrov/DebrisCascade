# .NET build output
bin/
obj/
*.user

# CUDA / native build artifacts (rebuild with src/DebrisCascade.Native/build.bat)
*.exp
*.lib
src/DebrisCascade.Native/debriscascade_cuda.dll

# CelesTrak catalog caches (re-downloaded on demand)
data/*.tle
data/satcat.csv
data/spacetrack_satcat.csv

# Generated visualization builds (concatenated from parts + data)
viz/index.html
viz/charts.html

# OS / editor
.vs/
*.swp
Thumbs.db

# Deck working backups (safety copies)
*.bak.pptx
*.bak[0-9].pptx
# Office lock files (a document is open)
~$*
