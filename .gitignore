# .NET build output
bin/
obj/
*.user

# CUDA / native build artifacts (rebuild with src/DebrisCascade.Native/build.bat)
*.exp
*.lib
src/DebrisCascade.Native/debriscascade_cuda.dll

# CelesTrak catalog caches (re-downloaded on demand)
data/*.tle
data/satcat.csv
data/spacetrack_satcat.csv

# Source papers: copyrighted, not redistributed (links in docs/REFERENCES.md)
docs/*.pdf

# Single-run CLI outputs (--evolve, --cascade, --conjunction, --charts); the committed results are
# data/deck_numbers.json and data/benchmark_2006.json
data/evolution.json
data/cascade.json
data/conjunction.json
data/charts.json

# Generated visualization builds (concatenated from parts + data)
viz/index.html
viz/charts.html

# OS / editor
.vs/
*.swp
Thumbs.db

# Deck working backups (safety copies)
*.bak.pptx
*.bak[0-9].pptx
# Office lock files (a document is open)
~$*
